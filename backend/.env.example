# Copie ce fichier en `.env` et remplis tes valeurs. Ne commit JAMAIS le `.env`.

# Génère une clé API depuis ton compte OANDA :
# https://www.oanda.com/account/tpa/personal_token
OANDA_API_KEY=

# Identifiant de ton compte OANDA (visible dans le portail, format 001-xxx-xxxxxxx-001)
OANDA_ACCOUNT_ID=

# "practice" = compte démo / argent fictif (recommandé pour commencer)
# "live"     = argent réel — à activer uniquement quand tu es prêt
OANDA_ENVIRONMENT=practice

# Durée de cache du scanner en secondes (évite de spammer l'API OANDA)
SCANNER_CACHE_TTL_SECONDS=30

# Garde-fou Phase 3 : même avec OANDA_ENVIRONMENT=live, AUCUN ordre réel
# n'est envoyé tant que ce flag n'est pas explicitement à true. Ne l'active
# que quand tu es prêt à risquer de l'argent réel.
LIVE_TRADING_CONFIRMED=false

# Plafond serveur : aucune requête ne peut faire risquer plus que ce
# pourcentage du solde sur un seul trade, quoi que le client envoie.
MAX_RISK_PCT=0.02

# Plafond serveur sur la perte CUMULÉE d'une session (fraction du solde).
# Une session enchaîne plusieurs trades : sans ce plafond, une série de
# pertes pourrait éroder tout le compte. Tu fournis ta propre perte max au
# démarrage, elle est ensuite bornée par celle-ci.
MAX_SESSION_LOSS_PCT=0.10

# Nombre max de trades qu'une session peut enchaîner, quoi qu'il arrive.
MAX_TRADES_PER_SESSION=20

# Fréquence de vérification de l'état du trade en cours, en secondes.
SESSION_POLL_SECONDS=5

# Plafond du spread, en fraction de la distance du stop-loss. Au-delà, le
# trade est REFUSÉ : les frais rongeraient trop l'espérance de gain.
# 0.15 = le spread ne doit pas dépasser 15% de ce que tu risques.
# Voir la section « Frais » du README avant de l'augmenter.
MAX_SPREAD_RATIO=0.15

# --- Notifications Web Push (paliers 25 / 50 / 75 / 100 %) ---
# Génère une paire de clés une seule fois :
#   cd backend && .venv/bin/python -c \
#     "from app.notifier import generate_vapid_keys; generate_vapid_keys()"
# Laisse vide pour désactiver le push : les paliers restent lisibles via
# GET /api/sessions/{id}/milestones, mais rien n'arrive sur le téléphone.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=
